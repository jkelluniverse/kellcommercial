# Kell Commercial — environment template.
# Copy to backend/.env and fill in real values. NEVER commit the real .env.

# ── Database (MongoDB) ──────────────────────────────────────────────
MONGO_URL="mongodb://localhost:27017"
DB_NAME="kellcommercial"

# ── Auth ────────────────────────────────────────────────────────────
# Long random string used to sign JWTs (e.g. `openssl rand -hex 32`).
JWT_SECRET="change-me-to-a-long-random-secret"

# Sole admin/editor (Jacob). Seeded on startup; idempotent.
ADMIN_EMAIL="jacob@nicecityhomes.com"
ADMIN_PASSWORD="set-a-strong-password"
ADMIN_NAME="Jacob"

# View-only user (Dad). Receives payment notifications.
VIEWER_EMAIL="dad@example.com"
VIEWER_PASSWORD="set-a-strong-password"
VIEWER_NAME="Dad"

# ── Rentec Direct (read-only) ───────────────────────────────────────
# Settings → Utilities → API Keys, with READ perms on properties,
# tenants, leases, transactions, accounts. Rate limit: 60 req/min.
RENTEC_API_KEY=""
RENTEC_BASE_URL="https://secure.rentecdirect.com/api/v3"
# How often the background sync refreshes the cached snapshot (minutes).
RENTEC_SYNC_INTERVAL_MIN="60"

# ── Email notifications (Gmail SMTP via App Password) ───────────────
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
EMAIL_FROM_NAME="Kell Commercial"
